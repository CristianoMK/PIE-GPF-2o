# Porta HTTP interna do backend
PORT=3000
# Use production na hospedagem
NODE_ENV=development
# Origem exata do frontend, incluindo esquema e porta quando aplicável
FRONTEND_URL=http://localhost:5500
# Chave de envio criada no Resend
RESEND_API_KEY=
# Endereço remetente de um domínio verificado no Resend
RESEND_FROM=
# Caixa que receberá as solicitações
RESEND_TO=
# Chave secreta do widget Turnstile
TURNSTILE_SECRET_KEY=
# IP ou CIDR do proxy confiável que se conecta ao backend, se houver
TRUST_PROXY=
